# Copy to .env (local) or set these in your host's dashboard.
JWT_SECRET=put-a-long-random-string-here
# Optional: require this code at signup (stops random bots, share it only with classmates)
SIGNUP_INVITE=
# Where SQLite stores data. On a host, point this at a persistent disk, e.g. /data/chat.db
DB_PATH=./chat.db
PORT=3000
